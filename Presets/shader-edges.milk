[preset00]
MILKDROP_PRESET_VERSION=201
fRating=3.000000
fGammaAdj=1.500000
fDecay=0.970000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=1
bMaximizeWaveColor=1
bTexWrap=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.800000
fWaveScale=1.300000
fWaveParam=-0.250000
fWarpAnimSpeed=1.000000
fWarpScale=1.000000
fZoomExponent=1.000000
zoom=1.000000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=0.000000
sx=1.000000
sy=1.000000
wave_r=1.000000
wave_g=1.000000
wave_b=1.000000
wave_x=0.500000
wave_y=0.500000
ob_size=0.010000
ob_r=0.000000
ob_g=0.000000
ob_b=0.000000
ob_a=0.000000
ib_size=0.010000
ib_r=0.250000
ib_g=0.250000
ib_b=0.250000
ib_a=0.000000
per_frame_1=wave_r = 0.5 + 0.5*sin(time*1.13 + 1.28);
per_frame_2=wave_g = 0.5 + 0.5*sin(time*0.91 + 3.28);
per_frame_3=wave_b = 0.5 + 0.5*sin(time*0.77 + 5.28);
per_frame_4=zoom = 1.02;
per_frame_5=rot = 0.01;
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
comp_1=`shader_body {
comp_2=`    float2 d = texsize.zw * 1.5;
comp_3=`    float3 dx = tex2D(sampler_main, uv + float2(d.x, 0)).xyz - tex2D(sampler_main, uv - float2(d.x, 0)).xyz;
comp_4=`    float3 dy = tex2D(sampler_main, uv + float2(0, d.y)).xyz - tex2D(sampler_main, uv - float2(0, d.y)).xyz;
comp_5=`    float3 edge = sqrt(dx * dx + dy * dy) * 3.0;
comp_6=`    ret = edge * (0.6 + 0.4 * hue_shader) + tex2D(sampler_main, uv).xyz * 0.15;
comp_7=`}
