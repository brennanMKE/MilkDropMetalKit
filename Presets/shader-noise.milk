per_frame_1=wave_r = 0.5 + 0.5*sin(time*1.13 + 4.16);
per_frame_2=wave_g = 0.5 + 0.5*sin(time*0.91 + 6.16);
per_frame_3=wave_b = 0.5 + 0.5*sin(time*0.77 + 8.16);
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
warp_1=`shader_body {
warp_2=`    float3 n = tex3D(sampler_noisevol_hq, float3(uv * 1.5, time * 0.05)).xyz;
warp_3=`    float2 push = (n.xy - 0.5) * 0.004 + (uv - 0.5) * 0.004;
warp_4=`    ret = tex2D(sampler_main, uv - push).xyz * 0.975 + (n - 0.5) * 0.01;
warp_5=`}
