[preset00]
MILKDROP_PRESET_VERSION=201
fRating=3.000000
fGammaAdj=1.500000
fDecay=0.960000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=1
bMaximizeWaveColor=1
bTexWrap=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.800000
fWaveScale=1.000000
fWaveParam=-0.250000
fWarpAnimSpeed=1.000000
fWarpScale=1.000000
fZoomExponent=1.000000
zoom=1.000000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=0.000000
sx=1.000000
sy=1.000000
wave_r=1.000000
wave_g=1.000000
wave_b=1.000000
wave_x=0.500000
wave_y=0.500000
ob_size=0.010000
ob_r=0.000000
ob_g=0.000000
ob_b=0.000000
ob_a=0.000000
ib_size=0.010000
ib_r=0.250000
ib_g=0.250000
ib_b=0.250000
ib_a=0.000000
per_frame_1=wave_r = 0.5 + 0.5*sin(time*1.13 + 0.76);
per_frame_2=wave_g = 0.5 + 0.5*sin(time*0.91 + 2.76);
per_frame_3=wave_b = 0.5 + 0.5*sin(time*0.77 + 4.76);
per_frame_4=zoom = 1.02;
per_frame_5=rot = 0.01;
per_frame_6=q1 = bass_att;
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
comp_1=`shader_body {
comp_2=`    float3 c = tex2D(sampler_main, uv).xyz;
comp_3=`    float l = lum(c);
comp_4=`    ret = 0.5 + 0.5 * cos(6.2832 * (l * 1.5 + time * 0.07 + float3(0.0, 0.33, 0.67)));
comp_5=`    ret *= saturate(l * 3.0) * (0.8 + 0.2 * q1);
comp_6=`}
